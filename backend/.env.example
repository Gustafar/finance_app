# Postgres connection string. Supabase: Project Settings > Database >
# Connection string > URI (use the "Transaction pooler" one if given a choice).
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Port the API listens on. Render sets this automatically in production —
# leave it unset there. Defaults to 9080 for local dev.
PORT=9080

# Origin allowed by CORS — your deployed frontend's URL in production.
FRONTEND_URL=http://localhost:5173

# Optional password gate. Leave both blank to disable auth entirely
# (frictionless local dev — every request is allowed through unchecked).
# Set both to require a password before the app can be used.
APP_PASSWORD=
# Generate with: openssl rand -hex 32
APP_TOKEN_SECRET=
